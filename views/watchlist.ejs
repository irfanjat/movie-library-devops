<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Watchlist - Movie Library</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f0f23; color: #e0e0e0; min-height: 100vh; }
    .container { max-width: 800px; margin: 0 auto; padding: 2rem; }
    header { text-align: center; padding: 2rem 0; border-bottom: 2px solid #3a3a5c; margin-bottom: 2rem; }
    header h1 { font-size: 2.5rem; color: #ffd700; }
    nav { text-align: center; margin-bottom: 2rem; }
    nav a { color: #ffd700; text-decoration: none; margin: 0 1rem; font-size: 1.1rem; padding: 0.5rem 1.5rem; border: 1px solid #3a3a5c; border-radius: 5px; transition: all 0.3s; }
    nav a:hover { background: #ffd700; color: #0f0f23; }
    .watchlist-item {
      display: flex; align-items: center; gap: 1.2rem;
      background: #1a1a3a; border: 1px solid #3a3a5c; border-radius: 10px; padding: 1.2rem 1.5rem; margin-bottom: 1rem;
      transition: border-color 0.3s;
    }
    .watchlist-item:hover { border-color: #ffd700; }
    .watchlist-item .poster { font-size: 2.5rem; }
    .watchlist-item .info { flex: 1; }
    .watchlist-item .info h3 { color: #ffd700; font-size: 1.2rem; }
    .watchlist-item .status { font-size: 0.9rem; }
    .watchlist-item .status.watched { color: #66cc66; }
    .watchlist-item .status.unwatched { color: #ffaa66; }
    .actions { display: flex; gap: 0.5rem; }
    .btn { padding: 0.4rem 1rem; border-radius: 5px; text-decoration: none; font-size: 0.85rem; cursor: pointer; border: none; font-weight: bold; transition: opacity 0.3s; }
    .btn-gold { background: #ffd700; color: #0f0f23; }
    .btn-red { background: #cc4444; color: #fff; }
    .btn-gray { background: #3a3a5c; color: #e0e0e0; }
    .btn:hover { opacity: 0.8; }
    .empty { text-align: center; padding: 3rem; color: #6666aa; font-size: 1.2rem; }
    .stats { text-align: center; color: #8888aa; margin-bottom: 1.5rem; font-size: 0.95rem; }
  </style>
</head>
<body>
  <div class="container">
    <header><h1>📋 My Watchlist</h1></header>
    <nav><a href="/">Browse</a><a href="/watchlist">My Watchlist</a></nav>
    <% if (watchlist.length > 0) { %>
      <div class="stats">
        <%= watchlist.filter(w => w.watched).length %> watched · <%= watchlist.filter(w => !w.watched).length %> to watch
      </div>
      <% watchlist.forEach(function(w) { %>
        <div class="watchlist-item">
          <div class="poster"><%= w.poster %></div>
          <div class="info">
            <h3><%= w.title %></h3>
            <div class="status <%= w.watched ? 'watched' : 'unwatched' %>">
              <%= w.watched ? '✅ Watched' : '⏳ To Watch' %>
            </div>
          </div>
          <div class="actions">
            <form method="POST" action="/watchlist/toggle/<%= w.id %>" style="display:inline;">
              <button type="submit" class="btn <%= w.watched ? 'btn-gray' : 'btn-gold' %>">
                <%= w.watched ? 'Mark Unwatched' : 'Mark Watched' %>
              </button>
            </form>
            <form method="POST" action="/watchlist/remove/<%= w.id %>" style="display:inline;">
              <button type="submit" class="btn btn-red">Remove</button>
            </form>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="empty">Your watchlist is empty. Browse movies to add some! 🎬</div>
    <% } %>
  </div>
</body>
</html>
