<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Movie Library</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #0f0f23;
      color: #e0e0e0; min-height: 100vh;
    }
    .container { max-width: 1100px; margin: 0 auto; padding: 2rem; }
    header { text-align: center; padding: 2rem 0; border-bottom: 2px solid #3a3a5c; margin-bottom: 2rem; }
    header h1 { font-size: 2.8rem; color: #ffd700; }
    header p { color: #8888aa; margin-top: 0.3rem; }
    nav { text-align: center; margin-bottom: 2rem; }
    nav a { color: #ffd700; text-decoration: none; margin: 0 1rem; font-size: 1.1rem; padding: 0.5rem 1.5rem; border: 1px solid #3a3a5c; border-radius: 5px; transition: all 0.3s; }
    nav a:hover { background: #ffd700; color: #0f0f23; }
    .filters { display: flex; gap: 1rem; justify-content: center; margin-bottom: 2rem; flex-wrap: wrap; }
    .filters select, .filters input { padding: 0.6rem; border-radius: 5px; border: 1px solid #3a3a5c; background: #1a1a3a; color: #e0e0e0; font-size: 0.95rem; }
    .filters button { padding: 0.6rem 1.2rem; background: #ffd700; color: #0f0f23; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; }
    .filters button:hover { background: #ffed4a; }
    .movie-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.5rem; }
    .movie-card {
      background: #1a1a3a; border: 1px solid #3a3a5c; border-radius: 10px; padding: 1.5rem; text-align: center;
      transition: transform 0.3s, border-color 0.3s; cursor: pointer;
    }
    .movie-card:hover { transform: translateY(-5px); border-color: #ffd700; }
    .movie-card .poster { font-size: 3.5rem; margin-bottom: 0.5rem; }
    .movie-card h3 { color: #ffd700; font-size: 1.1rem; margin-bottom: 0.3rem; }
    .movie-card .meta { color: #8888aa; font-size: 0.85rem; margin-bottom: 0.3rem; }
    .movie-card .rating { color: #ffd700; font-weight: bold; font-size: 1rem; }
    .no-results { text-align: center; padding: 3rem; color: #6666aa; font-size: 1.2rem; grid-column: 1 / -1; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>🎬 Movie Library</h1>
      <p>Discover, browse, and track your favorite films</p>
    </header>
    <nav>
      <a href="/">Browse</a>
      <a href="/watchlist">My Watchlist</a>
    </nav>
    <form class="filters" method="GET" action="/">
      <select name="genre">
        <option value="">All Genres</option>
        <% genres.forEach(function(g) { %>
          <option value="<%= g %>" <%= selectedGenre === g ? 'selected' : '' %>><%= g %></option>
        <% }); %>
      </select>
      <input type="text" name="q" placeholder="Search movies..." value="<%= query %>">
      <button type="submit">Filter</button>
    </form>
    <div class="movie-grid">
      <% if (movies.length > 0) { %>
        <% movies.forEach(function(m) { %>
          <a href="/movie/<%= m.id %>" style="text-decoration:none;color:inherit;">
            <div class="movie-card">
              <div class="poster"><%= m.poster %></div>
              <h3><%= m.title %></h3>
              <div class="meta"><%= m.year %> · <%= m.genre %></div>
              <div class="rating">★ <%= m.rating %></div>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <div class="no-results">No movies found. Try a different search! 🎥</div>
      <% } %>
    </div>
  </div>
</body>
</html>
